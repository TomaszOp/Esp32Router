/**
 * @file Secrets.h.example
 * @brief Template of include/Secrets.h – default AP name and password and the panel password.
 *
 * Used when there is no /config/wifi.json (first start, factory reset). Copy this file as
 * include/Secrets.h and enter your own values. include/Secrets.h is in .gitignore.
 *
 * The upstream network (STA) is set from the console: wifi sta "SSID" password, then save.
 * By default the STA does not connect.
 */
#pragma once

// "-XXXX" (last 2 bytes of the MAC) is appended to the SSID, e.g. Esp32Router-A1B2.
#define SECRET_AP_SSID "Esp32Router"

// Empty = open network. A non-empty password needs at least 8 characters (shorter is rejected, the AP will be open).
#define SECRET_AP_PASS "zmien-to-haslo"

// Default web panel password (used until you change it in the panel or with "web passwd").

#define SECRET_WEB_PASS "zmien-to-haslo"
